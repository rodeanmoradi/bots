<?xml version="1.0"?>
<package format="3">
  <name>bracketbot_moveit_config</name>
  <version>0.1.0</version>
  <description>
    MoveIt 2 configuration for BracketBot (chopped_urdf_v2). Drag an interactive
    marker in RViz to teleoperate either 7-DOF arm, against ros2_control mock
    hardware (no simulator needed) or attached to the Gazebo sim from
    chopped_urdf_v2_gazebo. Used to record therapy demonstrations as joint-angle
    trajectories.
  </description>
  <maintainer email="rodean.moradi@gmail.com">Rodean Moradi</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>chopped_urdf_v2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_setup_assistant</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>rosbag2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
